#
# mod-playerhousing configuration
#

###############################################################################
# PlayerHousing.Enable
#    Enables or disables the whole module.
#    Default: 1
###############################################################################
PlayerHousing.Enable = 1

###############################################################################
# PlayerHousing.FreeMode
#    Test servers: copies from the Collection cost nothing, and the House Key
#    takes you home instantly.
#    Default: 0
###############################################################################
PlayerHousing.FreeMode = 0

###############################################################################
# PlayerHousing.UnlockAll
#    Test servers: the whole Collection is unlocked for everyone, and the
#    Collection offers "one of everything". Leave it off to test the unlocks
#    themselves (GMs: .house unlock / relock).
#    Default: 0
###############################################################################
PlayerHousing.UnlockAll = 0

###############################################################################
# PlayerHousing.Layout
#    Which island layout to use (table mod_playerhousing_layout):
#      cleared     GM Island without its guild hall. Needs the matching server
#                  data and client patch, see tools/gm-island-cleared.
#      guildhouse  GM Island as it ships, landing in the guild hall.
#    Default: cleared
###############################################################################
PlayerHousing.Layout = "cleared"

###############################################################################
# PlayerHousing.DefaultPrivacy
#    Who may visit a new island: private (the owner's guest list), friends
#    (friends, guild and guests) or public (anyone).
#    Default: private
###############################################################################
PlayerHousing.DefaultPrivacy = "private"

###############################################################################
# PlayerHousing.GmBypassPrivate
#    GMs (in GM mode) can visit any island.
#    Default: 0
###############################################################################
PlayerHousing.GmBypassPrivate = 0

###############################################################################
# PlayerHousing.MaxFurnishings
# PlayerHousing.MaxBuildings
#    How many furnishings and buildings one island can hold. Every open island
#    shares the same few map cells, so these keep the server quick when many
#    islands are occupied at once.
#    Default: 200, 10
###############################################################################
PlayerHousing.MaxFurnishings = 200
PlayerHousing.MaxBuildings = 10

###############################################################################
# PlayerHousing.HouseKey.DelaySeconds
#    How long "Go home" takes (moving or combat cancels). 0 = instant.
#    FreeMode always goes instantly.
#    Default: 5
###############################################################################
PlayerHousing.HouseKey.DelaySeconds = 5

###############################################################################
# PlayerHousing.StewardEntry
# PlayerHousing.StewardDisplayId
#    Krook, the housing steward, and the model Krook uses (25384: Wolvar orphan).
###############################################################################
PlayerHousing.StewardEntry = 900200
PlayerHousing.StewardDisplayId = 25384
