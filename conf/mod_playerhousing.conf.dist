#
# mod-playerhousing configuration
#

###############################################################################
# PlayerHousing.Enable
#    Enables or disables the whole module.
#    Default: 1
###############################################################################
PlayerHousing.Enable = 1

###############################################################################
# PlayerHousing.FreeMode
#    Test servers: copies from the Collection cost nothing, and the House Key
#    takes you home instantly.
#    Default: 0
###############################################################################
PlayerHousing.FreeMode = 0

###############################################################################
# PlayerHousing.UnlockAll
#    Test servers: the whole Collection is unlocked for everyone, and the
#    Collection offers "one of everything". Leave it off to test the unlocks
#    themselves (GMs: .house unlock / relock).
#    Default: 0
###############################################################################
PlayerHousing.UnlockAll = 0

###############################################################################
# PlayerHousing.Layout
#    Which island layout to use (table mod_playerhousing_layout):
#      cleared     GM Island without its guild hall. Needs the matching server
#                  data and client patch, see tools/gm-island-cleared.
#      guildhouse  GM Island as it ships, landing in the guild hall.
#    Default: cleared
###############################################################################
PlayerHousing.Layout = "cleared"

###############################################################################
# PlayerHousing.DefaultPrivacy
#    Who may visit a new island: private (the owner's guest list), friends
#    (friends, guild and guests) or public (anyone).
#    Default: private
###############################################################################
PlayerHousing.DefaultPrivacy = "private"

###############################################################################
# PlayerHousing.GmBypassPrivate
#    GMs (in GM mode) can visit any island.
#    Default: 0
###############################################################################
PlayerHousing.GmBypassPrivate = 0

###############################################################################
# PlayerHousing.MaxFurnishings
# PlayerHousing.MaxBuildings
#    How many furnishings and buildings one island can hold. Every open island
#    shares the same few map cells, so these keep the server quick when many
#    islands are occupied at once.
#    Default: 200, 10
###############################################################################
PlayerHousing.MaxFurnishings = 200
PlayerHousing.MaxBuildings = 10

###############################################################################
# PlayerHousing.Size.Min
# PlayerHousing.Size.Max
#    How small and how big players may make a piece, as a multiple of its
#    normal size. 1 and 1 turn resizing off.
#    Default: 0.5, 2
###############################################################################
PlayerHousing.Size.Min = 0.5
PlayerHousing.Size.Max = 2

###############################################################################
# PlayerHousing.Tilt.Max
#    How far players may tilt a piece, in degrees each way (forward and back,
#    left and right). 180 is no limit: pieces turn right over, upside down and
#    on round. 0 turns tilting off. Mannequins and figurines always stand
#    upright (the client can't tilt a creature).
#    Default: 180
###############################################################################
PlayerHousing.Tilt.Max = 180

###############################################################################
# PlayerHousing.SavedLayouts
#    How many layouts each island (one per account) can keep: snapshots of
#    where everything stands, to set out again or send to a friend. 0 turns
#    them off. Up to 20.
#    Default: 5
###############################################################################
PlayerHousing.SavedLayouts = 5

###############################################################################
# PlayerHousing.Catalog
#    curated     the pieces earned through progression (default)
#    everything  also every other object model in the game (about 2,000), one
#                piece each, everyone's from the start, in the Collection's
#                Catalog (search it by name). Needs
#                sql/db_world/base/mod_playerhousing_world_catalog.sql applied.
#    Default: curated
###############################################################################
PlayerHousing.Catalog = "curated"

###############################################################################
# PlayerHousing.Ghosts
#    1  a piece being placed or moved follows the mouse (with PlayerHousing.dll)
#       or its player as a see-through copy of itself; world-model buildings
#       show as their real, solid object. Players need the client patch from
#       tools/gm-island-cleared built with this version: it adds the ghosts'
#       models, and without it the ghost can't be seen.
#    0  every piece is carried as it is (no see-through ghosts); for clients
#       with an older patch.
#    Default: 1
###############################################################################
PlayerHousing.Ghosts = 1

###############################################################################
# PlayerHousing.HouseKey.DelaySeconds
#    How long "Go home" takes (moving or combat cancels). 0 = instant.
#    FreeMode always goes instantly.
#    Default: 0
###############################################################################
PlayerHousing.HouseKey.DelaySeconds = 0

###############################################################################
# PlayerHousing.StewardEntry
# PlayerHousing.StewardDisplayId
#    Krook, the housing steward, and the model Krook uses (25384: Wolvar orphan).
###############################################################################
PlayerHousing.StewardEntry = 900200
PlayerHousing.StewardDisplayId = 25384
